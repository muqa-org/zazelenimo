# Example environment variables for the database connection
# Replace the placeholders with your actual database credentials

# Database connection URL for pooled connections
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Database connection URL for non-pooled connections (e.g., migrations)
DATABASE_URL_NON_POOLING=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME> 

